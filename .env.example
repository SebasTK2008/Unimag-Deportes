# Ejemplo local. Copie este archivo a .env y complete los valores.
# No use estas configuraciones ni el perfil dev como configuración de producción.
# Claves distintas de al menos 32 bytes UTF-8; no guarde claves reales en Git.
APP_AUTH_JWT_SECRET=
APP_AUTH_CODE_HMAC_SECRET=

APP_AUTH_CODE_VALIDITY=PT15M
APP_AUTH_CODE_MAX_ATTEMPTS=5
APP_AUTH_CODE_RESEND_INTERVAL=PT1M
APP_AUTH_CODE_MAX_REQUESTS_PER_EMAIL=5
APP_AUTH_ADMIN_EMAILS=
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# URLs locales del frontend futuro; HTTP para QR requiere activar dev explícitamente.
# Al desplegar, sustituya los orígenes/URLs por HTTPS y no active dev.
APP_CHECKIN_FRONTEND_ORIGIN=http://localhost:5173
APP_MAIL_CONTACT_URL=http://localhost:5173/app/contacto
APP_MAIL_CONTACT_RECIPIENT=salcendra@unimagdalena.edu.co
APP_MAIL_CANCELLATION_URL=http://localhost:5173/reservations/{id}/cancel

# Desarrollo local con Mailpit.
# Estos puertos se publican en localhost. El perfil Compose "app" conecta con postgres y mailpit por sus nombres internos.
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=secret
POSTGRES_HOST_PORT=5433
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
APP_PORT=8080
# Puerto de Spring cuando se ejecuta con Maven/JAR. APP_PORT solo publica el contenedor.
SERVER_PORT=8080
# Solo si se necesita explícitamente el perfil dev; no usar en producción.
# SPRING_PROFILES_ACTIVE=dev
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
# Remitente autorizado por el proveedor SMTP; opcional con Mailpit.
APP_MAIL_FROM=

APP_RULES_BOOKING_TOLERANCE_MINUTES=10
APP_RULES_LATE_CANCELLATION_MINUTES=60
APP_RULES_MIN_ADVANCE_MINUTES=0
APP_RULES_CHECKIN_OPENING_MINUTES=10
APP_RULES_SUSPENSION_DAYS=7
# Crons de Spring (segundos incluidos); - desactiva cada job. Sin comillas al importar como propiedades.
APP_JOBS_RESERVATION_LIFECYCLE_CRON=0 * * * * *
APP_JOBS_REMINDER_CRON=0 * * * * *
APP_JOBS_AUTH_CLEANUP_CRON=0 0 * * * *

# Solo para PostgreSQL externo. Déjelas comentadas al usar la integración Compose.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/unimagdeportes
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
